
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if the user has developer/admin privileges
    function isDev() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('dev', false) == true;
    }

    // Rules for user profiles
    match /users/{userId} {
      allow get: if request.auth != null;
      allow list: if isDev();
      allow write: if (request.auth != null && request.auth.uid == userId) || isDev();
    }

    // Rules for servers
    match /servers/{serverId} {
      allow read, write: if request.auth != null && (
        (resource == null || resource.data.ownerId == request.auth.uid) || 
        (request.resource != null && request.resource.data.ownerId == request.auth.uid) ||
        isDev()
      );
    }

    // Rules for infrastructure agents
    match /infrastructure_agents/{agentId} {
      allow read: if request.auth != null;
      allow write: if isDev();
    }

    // Rules for transactions
    match /transactions/{transactionId} {
      allow get: if isDev() || (request.auth != null && resource.data.userId == request.auth.uid);
      allow list: if isDev();
      allow write: if isDev();
    }

    // Rules for main configurations (like product pricing)
    match /main/{documentId} {
      allow read: if true; // Publicly readable for all users
      allow write: if request.auth != null; // Allow authenticated users to write (for prototype initialization)
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
