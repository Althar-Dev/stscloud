
{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Stores extended user information and preferences.",
      "type": "object",
      "properties": {
        "displayName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "photoURL": { "type": "string" },
        "dev": { "type": "boolean", "description": "Whether the user has developer/admin privileges." },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email"]
    },
    "Server": {
      "title": "Server",
      "description": "Information about a deployed server node.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "ownerId": { "type": "string" },
        "plan": { "type": "string" },
        "status": { "type": "string", "enum": ["online", "offline", "starting"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time", "description": "When the server subscription expires." },
        "expirationNoticeSent": { "type": "boolean", "description": "Whether the 24h expiration warning email was sent." },
        "runtime": { "type": "string" },
        "template": { "type": "string", "description": "The selected deployment template (e.g., website, bots)." },
        "nodeVersion": { "type": "string", "description": "Selected Node.js version for the server." },
        "startupCommand": { "type": "string", "description": "Custom command to start the application." },
        "commandRun": { "type": "string", "description": "The command runner (e.g., node, npm, yarn)." },
        "entryFile": { "type": "string", "description": "The entry point JS file." },
        "resources": {
          "type": "object",
          "properties": {
            "cpu": { "type": "string" },
            "ram": { "type": "string" },
            "disk": { "type": "string" }
          }
        }
      },
      "required": ["name", "ownerId"]
    },
    "InfrastructureAgent": {
      "title": "Infrastructure Agent",
      "description": "A global infrastructure cluster node.",
      "type": "object",
      "properties": {
        "regionName": { "type": "string" },
        "domain": { "type": "string", "description": "The domain pointing to the agent." },
        "ip": { "type": "string", "description": "The public IP address of the agent." },
        "status": { "type": "string", "enum": ["online", "warning", "offline"] },
        "load": { "type": "number", "description": "Current percentage load on the agent cluster." },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["regionName", "domain", "ip"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "A payment record processed through SValePay.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "amount": { "type": "number" },
        "plan": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "externalId": { "type": "string" }
      },
      "required": ["userId", "amount", "status"]
    },
    "ProductPricing": {
      "title": "Product Pricing",
      "description": "Global pricing configuration for server tiers.",
      "type": "object",
      "properties": {
        "tiers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "ram": { "type": "string" },
              "cpu": { "type": "string" },
              "disk": { "type": "string" },
              "price": { "type": "string" },
              "priceValue": { "type": "number" },
              "popular": { "type": "boolean" },
              "stock": { "type": "number", "description": "Manual available stock count." }
            }
          }
        }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile document indexed by Firebase Auth UID."
    },
    "/servers/{serverId}": {
      "schema": "Server",
      "description": "Root document for a server node."
    },
    "/infrastructure_agents/{agentId}": {
      "schema": "InfrastructureAgent",
      "description": "Global infrastructure cluster records."
    },
    "/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Billing records for the platform."
    },
    "/main/{documentId}": {
      "schema": "ProductPricing",
      "description": "Core configuration documents for the application."
    }
  }
}
